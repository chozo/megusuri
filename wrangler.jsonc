{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "megusuri-game",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "game.chozo.net/megusuri/*",
      "zone_name": "chozo.net"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/megusuri"]
  }
}
